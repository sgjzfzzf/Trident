#include "mlir/Dialect/Arith/IR/ArithOps.td"
#include "torch-mlir/Dialect/Torch/IR/TorchOps.td"
#include "torch-mlir/Dialect/TorchConversion/IR/TorchConversionOps.td"
#include "trident/core/Dialect/TorchExt/IR/TorchExtOps.td"
#include "trident/core/Dialect/TVMFFI/IR/TVMFFIOps.td"

Pattern AtenAddInt with benefit(1) {
  let root = op<torch.aten.add.int>(a: Value, b: Value) -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i64>(a) -> (type<"i64">);
    let nativeB = op<torch_c.to_i64>(b) -> (type<"i64">);
    let nativeResult = op<arith.addi>(nativeA, nativeB) -> (type<"i64">);
    replace root with op<torch_c.from_i64>(nativeResult) -> (types);
  };
}

Pattern AtenFloordivInt with benefit(1) {
  let root = op<torch.aten.floordiv.int>(a: Value, b: Value)
      -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i64>(a) -> (type<"i64">);
    let nativeB = op<torch_c.to_i64>(b) -> (type<"i64">);
    let nativeResult =
        op<arith.floordivsi>(nativeA, nativeB) -> (type<"i64">);
    replace root with op<torch_c.from_i64>(nativeResult) -> (types);
  };
}

Pattern AtenIntBool with benefit(1) {
  let root = op<torch.aten.Int.bool>(a: Value) -> (types: TypeRange);
  rewrite root with {
    let nativeBool = op<torch_c.to_i1>(a) -> (type<"i1">);
    let nativeInt = op<arith.extui>(nativeBool) -> (type<"i64">);
    replace root with op<torch_c.from_i64>(nativeInt) -> (types);
  };
}

Pattern AtenAndBool with benefit(1) {
  let root = op<torch.aten.__and__.bool>(a: Value, b: Value)
      -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i1>(a) -> (type<"i1">);
    let nativeB = op<torch_c.to_i1>(b) -> (type<"i1">);
    let nativeResult = op<arith.andi>(nativeA, nativeB) -> (type<"i1">);
    replace root with op<torch_c.from_i1>(nativeResult) -> (types);
  };
}

Pattern AtenEqInt with benefit(1) {
  let root = op<torch.aten.eq.int>(a: Value, b: Value)
      -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i64>(a) -> (type<"i64">);
    let nativeB = op<torch_c.to_i64>(b) -> (type<"i64">);
    let nativeResult = op<arith.cmpi>(nativeA, nativeB) {
      predicate = attr<"0 : i64">
    } -> (type<"i1">);
    replace root with op<torch_c.from_i1>(nativeResult) -> (types);
  };
}

Pattern AtenMulInt with benefit(1) {
  let root = op<torch.aten.mul.int>(a: Value, b: Value) -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i64>(a) -> (type<"i64">);
    let nativeB = op<torch_c.to_i64>(b) -> (type<"i64">);
    let nativeResult = op<arith.muli>(nativeA, nativeB) -> (type<"i64">);
    replace root with op<torch_c.from_i64>(nativeResult) -> (types);
  };
}

Pattern AtenLeInt with benefit(1) {
  let root = op<torch.aten.le.int>(a: Value, b: Value)
      -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i64>(a) -> (type<"i64">);
    let nativeB = op<torch_c.to_i64>(b) -> (type<"i64">);
    let nativeResult = op<arith.cmpi>(nativeA, nativeB) {
      predicate = attr<"3 : i64">
    } -> (type<"i1">);
    replace root with op<torch_c.from_i1>(nativeResult) -> (types);
  };
}

Pattern AtenNotBool with benefit(1) {
  let root = op<torch.aten.__not__>(value: Value) -> (types: TypeRange);
  rewrite root with {
    let nativeValue = op<torch_c.to_i1>(value) -> (type<"i1">);
    let nativeOne = op<arith.constant> {
      value = attr<"1 : i1">
    } -> (type<"i1">);
    let nativeResult = op<arith.xori>(nativeValue, nativeOne)
        -> (type<"i1">);
    replace root with op<torch_c.from_i1>(nativeResult) -> (types);
  };
}

Pattern AtenOrBool with benefit(1) {
  let root = op<torch.aten.__or__.bool>(a: Value, b: Value)
      -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i1>(a) -> (type<"i1">);
    let nativeB = op<torch_c.to_i1>(b) -> (type<"i1">);
    let nativeResult = op<arith.ori>(nativeA, nativeB) -> (type<"i1">);
    replace root with op<torch_c.from_i1>(nativeResult) -> (types);
  };
}

Pattern AtenSizeInt with benefit(1) {
  let root = op<torch.aten.size.int>(self: Value, dim: Value)
      -> (types: TypeRange);
  rewrite root with {
    let nativeDim = op<torch_c.to_i64>(dim) -> (type<"i64">);
    let nativeSize =
        op<torchext.tensor.size>(self, nativeDim) -> (type<"i64">);
    replace root with op<torch_c.from_i64>(nativeSize) -> (types);
  };
}

Pattern AtenSubInt with benefit(1) {
  let root = op<torch.aten.sub.int>(a: Value, b: Value) -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i64>(a) -> (type<"i64">);
    let nativeB = op<torch_c.to_i64>(b) -> (type<"i64">);
    let nativeResult = op<arith.subi>(nativeA, nativeB) -> (type<"i64">);
    replace root with op<torch_c.from_i64>(nativeResult) -> (types);
  };
}
