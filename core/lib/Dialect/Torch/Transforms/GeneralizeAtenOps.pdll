  let root = op<torch.aten.div.float>(a: Value, b: Value)
      -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_f64>(a) -> (type<"f64">);
    let nativeB = op<torch_c.to_f64>(b) -> (type<"f64">);
    let nativeResult = op<arith.divf>(nativeA, nativeB) -> (type<"f64">);
