Pattern AtenSubInt with benefit(1) {
  let root = op<torch.aten.sub.int>(a: Value, b: Value) -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i64>(a) -> (type<"i64">);
    let nativeB = op<torch_c.to_i64>(b) -> (type<"i64">);
    let nativeResult = op<arith.subi>(nativeA, nativeB) -> (type<"i64">);
