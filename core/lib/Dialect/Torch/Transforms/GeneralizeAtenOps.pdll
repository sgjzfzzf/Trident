Pattern AtenNegFloat with benefit(1) {
  let root = op<torch.aten.neg.float>(a: Value) -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_f64>(a) -> (type<"f64">);
    let nativeResult = op<arith.negf>(nativeA) -> (type<"f64">);
    replace root with op<torch_c.from_f64>(nativeResult) -> (types);
  };
}

Pattern AtenNegInt with benefit(1) {
  let root = op<torch.aten.neg.int>(a: Value) -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i64>(a) -> (type<"i64">);
    let zero = op<arith.constant> {
      value = attr<"0 : i64">
    } -> (type<"i64">);
    let nativeResult = op<arith.subi>(zero, nativeA) -> (type<"i64">);
    replace root with op<torch_c.from_i64>(nativeResult) -> (types);
  };
}

Pattern AtenNotBool with benefit(1) {
  let root = op<torch.aten.__not__>(value: Value) -> (types: TypeRange);
  rewrite root with {
    let nativeValue = op<torch_c.to_i1>(value) -> (type<"i1">);
    let nativeOne = op<arith.constant> {
      value = attr<"1 : i1">
    } -> (type<"i1">);
    let nativeResult = op<arith.xori>(nativeValue, nativeOne)
        -> (type<"i1">);
    replace root with op<torch_c.from_i1>(nativeResult) -> (types);
  };
}

Pattern AtenOrBool with benefit(1) {
  let root = op<torch.aten.__or__.bool>(a: Value, b: Value)
      -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i1>(a) -> (type<"i1">);
    let nativeB = op<torch_c.to_i1>(b) -> (type<"i1">);
    let nativeResult = op<arith.ori>(nativeA, nativeB) -> (type<"i1">);
    replace root with op<torch_c.from_i1>(nativeResult) -> (types);
  };
}

Pattern AtenRemainderInt with benefit(1) {
  let root = op<torch.aten.remainder.int>(a: Value, b: Value)
      -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i64>(a) -> (type<"i64">);
    let nativeB = op<torch_c.to_i64>(b) -> (type<"i64">);
    let quotient = op<arith.floordivsi>(nativeA, nativeB) -> (type<"i64">);
    let product = op<arith.muli>(quotient, nativeB) -> (type<"i64">);
    let nativeResult = op<arith.subi>(nativeA, product) -> (type<"i64">);
    replace root with op<torch_c.from_i64>(nativeResult) -> (types);
  };
}

Pattern AtenSizeInt with benefit(1) {
  let root = op<torch.aten.size.int>(self: Value, dim: Value)
      -> (types: TypeRange);
  rewrite root with {
    let nativeDim = op<torch_c.to_i64>(dim) -> (type<"i64">);
    let nativeSize =
        op<torchext.tensor.size>(self, nativeDim) -> (type<"i64">);
    replace root with op<torch_c.from_i64>(nativeSize) -> (types);
  };
}

