Pattern AtenDivInt with benefit(1) {
  let root = op<torch.aten.div.int>(a: Value, b: Value)
      -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_i64>(a) -> (type<"i64">);
    let nativeB = op<torch_c.to_i64>(b) -> (type<"i64">);
    let floatA = op<arith.sitofp>(nativeA) -> (type<"f64">);
    let floatB = op<arith.sitofp>(nativeB) -> (type<"f64">);
    let nativeResult = op<arith.divf>(floatA, floatB) -> (type<"f64">);
    replace root with op<torch_c.from_f64>(nativeResult) -> (types);
  };
}

Pattern AtenEqFloat with benefit(1) {
  let root = op<torch.aten.eq.float>(a: Value, b: Value)
      -> (types: TypeRange);
  rewrite root with {
    let nativeA = op<torch_c.to_f64>(a) -> (type<"f64">);
    let nativeB = op<torch_c.to_f64>(b) -> (type<"f64">);
    let nativeResult = op<arith.cmpf>(nativeA, nativeB) {
      predicate = attr<"1 : i64">
    } -> (type<"i1">);
    replace root with op<torch_c.from_i1>(nativeResult) -> (types);
  };
}

